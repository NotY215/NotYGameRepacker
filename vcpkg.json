{
  "name": "noty-game-repacker",
  "version": "1.0.0",
  "description": "Professional Windows game packaging/repacking system",
  "homepage": "https://github.com",
  "license": "GPL-3.0",
  "supports": "windows & x64",
  "builtin-baseline": "e03dc9b29710050cd1018bc5674688108658d327",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "network",
        "concurrent",
        "opengl",
        "freetype",
        "harfbuzz",
        "png"
      ]
    },
    "zstd",
    "nlohmann-json",
    "blake3"
  ],
  "overrides": [
    {
      "name": "zstd",
      "version": "1.5.5"
    },
    {
      "name": "nlohmann-json",
      "version": "3.11.2"
    }
  ]
}

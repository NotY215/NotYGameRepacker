#include <windows.h>
#include "noty_resource.h"

#ifdef NOTY_HAS_LOGO
IDR_LOGO_PNG RCDATA "@NOTY_RESOURCE_DIR_CMAKE@/logo.png"
#endif

1 VERSIONINFO
FILEVERSION     @NOTY_VERSION_COMMA@
PRODUCTVERSION  @NOTY_VERSION_COMMA@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NotY215"
            VALUE "FileDescription",  "@NOTY_FILE_DESCRIPTION@"
            VALUE "FileVersion",      "@NOTY_VERSION_STR@"
            VALUE "InternalName",     "@NOTY_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "Copyright (C) NotY215"
            VALUE "OriginalFilename", "@NOTY_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "NotY Game Repacker"
            VALUE "ProductVersion",   "@NOTY_VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END